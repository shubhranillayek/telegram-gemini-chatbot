# Copy this file to .env and fill in your own keys.
# .env stays on your computer only — never upload it anywhere.

# Token from BotFather on Telegram (the bot's password)
TELEGRAM_BOT_TOKEN=

# Free API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: which Gemini model to use. The default is fast and free-tier friendly.
GEMINI_MODEL=gemini-2.5-flash
